# TMDB API Key for Cinemasis Movie/Series Metadata (optional, https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Sanity API Token for Mangile Reading Provider (optional, only needed for private draft inspection)
SANITY_TOKEN=

# Sanity Project ID (defaults to 1yge7tlr)
SANITY_PROJECT_ID=1yge7tlr

# Sanity Dataset (defaults to production)
SANITY_DATASET=production

# Core IPC listen address (TCP or unix:///path/to/socket)
VESSEL_LISTEN_ADDR=127.0.0.1:50050

# Custom themes directory
VESSEL_THEMES_DIR=
