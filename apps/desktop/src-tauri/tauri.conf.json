{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vessel",
  "version": "0.1.0",
  "identifier": "dev.falsis.vessel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vessel",
        "width": 1340,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "backgroundColor": "#1e1e2e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
