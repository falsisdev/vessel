{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vessel",
  "version": "0.3.6",
  "identifier": "dev.falsis.vessel",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Vessel",
        "width": 1340,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "transparent": false,
        "backgroundColor": "#0a0b10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Local-first, cross-platform streaming and media center",
    "longDescription": "Vessel is a local-first streaming and media center powered by Rust, Tauri v2, QuickJS plugins, local HTTP/HLS proxy, IPTV EPG, and offline downloads.",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
